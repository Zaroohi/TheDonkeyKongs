// Arduino code for Motor One 
// test


const int IN1 = 27;
const int IN2 = 26;
const int ENB = 33;

void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(ENB, LOW);
}

void loop() {
  // Motor 1 forward
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  delay(2000);

  // Stop Motor 1
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  delay(2000);
}


// Arduino code for Motor two
// test 


const int IN3 = 14;
const int IN4 = 25;
const int ENB = 33;

void setup() {
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);

  // Enable Motor 2
  digitalWrite(ENB, HIGH);
}

void loop() {
  // Motor 2 spins
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  delay(2000);

  // Motor 2 stops
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  delay(2000);
}
